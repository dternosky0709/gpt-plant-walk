# Required in the serverless deployment environment.
PDFBOLT_API_KEY=replace-with-your-private-pdfbolt-api-key

# Optional. Set to the exact production app origin for stricter CORS.
# Example: https://gpt-plant-walk.vercel.app
ALLOWED_ORIGIN=*

# Reserved for the future live AI provider. Do not put real secrets in this file.
OPENAI_API_KEY=replace-with-your-private-openai-api-key

# Maintenance Planner server-to-server synchronization. Keep these secrets in
# the deployment environment; never place them in browser code.
MAINTENANCE_PLANNER_URL=https://maintenance-planner.dternosky0709.chatgpt.site
PLANT_WALK_INTAKE_TOKEN=use-the-same-32-plus-character-secret-configured-in-maintenance-planner
MAINTENANCE_PLANNER_SITE_TOKEN=replace-with-the-sites-server-access-token
